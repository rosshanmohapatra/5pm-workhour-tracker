{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Setup window: event listening plus the custom title bar's minimize, close and drag.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
