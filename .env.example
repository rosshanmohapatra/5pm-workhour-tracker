# ─── Supabase ────────────────────────────────────────────────────────────────
# Public (safe to expose in the browser — data access is enforced by RLS)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NEVER put the service_role key here or in any client-side file.
# It bypasses ALL Row-Level Security and gives full DB access.
# If you need it for server-side scripts, keep it only in:
#   - Vercel environment variables (not prefixed with VITE_/NEXT_PUBLIC_)
#   - Local .env.local (which is gitignored)
# SUPABASE_SERVICE_ROLE_KEY=  ← leave this commented out

# ─── Web Push (Vercel serverless functions) ───────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key   # server-side only
VAPID_EMAIL=mailto:your@email.com
