{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "5pm Setup",
  "version": "1.0.0",
  "identifier": "com.5pm.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "5pm Setup",
        "width": 600,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../src-tauri/icons/icon.ico"]
  }
}
