{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "5pm",
  "version": "1.2.3",
  "identifier": "com.5pm.app",
  "build": {
    "frontendDist": "dist",
    "beforeDevCommand": "node scripts/build-desktop-dist.js",
    "beforeBuildCommand": "node scripts/build-desktop-dist.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "5pm",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["fivepm"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/rosshanmohapatra/5pm-workhour-tracker/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCNjJBNUE3RDBFODFGNEQKUldSTkgralFwNlZpeTZUeEZ3aE1CMmhOYmdzcEtUd1JzQkI0M2wyaXhlejFQSFF1Ym9MdFBLbHQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
