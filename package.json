{
  "name": "5pm-work-tracker",
  "version": "1.2.34",
  "description": "Work hour tracker with Web Push notifications",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "vapid": "node -e \"const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey);console.log('VAPID_PRIVATE_KEY='+k.privateKey);\"",
    "play": "node scripts/play.js",
    "test": "node --test tests/*.test.js",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/kv": "^2.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10"
  },
  "lint-staged": {
    "*.{js,html,css,json,md,yml}": "prettier --write",
    "*.js": "eslint"
  }
}
